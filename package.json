{
  "name": "playmaker-tackle",
  "version": "0.4.0",
  "private": true,
  "description": "Free offline tackle football playbook editor",
  "repository": "https://github.com/breksos/PlayMakerX",
  "main": "desktop/main.cjs",
  "scripts": {
    "check": "node --check app.js && node --check features.js && node --check desktop/main.cjs && node --check desktop/preload.cjs",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.playmaker.team.tackle",
    "productName": "Playmaker Tackle",
    "directories": { "output": "release" },
    "files": ["index.html", "styles.css", "features.css", "app.js", "features.js", "favicon.svg", "desktop/**/*", "package.json"],
    "win": {
      "icon": "desktop/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Playmaker-Tackle-Windows-${version}-Setup.${ext}"
    }
  }
}
